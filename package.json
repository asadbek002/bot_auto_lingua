{
  "name": "lingua-translation-agent",
  "version": "0.1.0",
  "description": "AI Telegram Business agent for Lingua Translation bureau",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "train": "tsx src/train/train.ts",
    "drive:authorize": "tsx src/drive/authorize.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@google/genai": "^2.10.0",
    "dotenv": "^17.4.2",
    "googleapis": "^173.0.0",
    "grammy": "^1.44.0",
    "node-cron": "^4.5.0",
    "node-html-parser": "^8.0.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
