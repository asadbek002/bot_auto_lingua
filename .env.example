# --- Telegram ---
# Create via @BotFather. Enable Secretary Mode (Business) for this bot, then
# connect it under Settings -> Business -> Chatbots on the real business account.
TELEGRAM_BOT_TOKEN=

# Your own chat id with the bot (or a group you use as "рабочий чат") -
# receives escalations, new-paid-order notices, and deadline reminders.
# Send /exclude /include /list_excluded here too.
WORK_CHAT_ID=

# Separate channel/chat id where every outgoing agent reply is duplicated for review.
LOG_CHANNEL_ID=

# --- Claude (the "brain": dialogue + business rules + structured order JSON) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# --- Gemini (the "perception" layer: voice/photo/PDF/receipt extraction) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_LITE=gemini-2.5-flash-lite

# --- Google Sheets / Drive ---
# Path to a service-account JSON keyfile (share the Sheet + Drive folder with
# its client_email, do NOT make them public).
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Drive uploads run as a real Google account via OAuth, not the service account above -
# service accounts have no Drive storage quota on a plain Gmail. Create an OAuth Client
# ID (type: Desktop app) in the same Google Cloud project, put its id/secret here, then
# run `npm run drive:authorize` once to produce GOOGLE_OAUTH_TOKEN_PATH.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_PATH=./google-oauth-token.json

# --- Business config ---
# Standard turnaround used to compute order status/deadlines (working days).
STANDARD_TURNAROUND_DAYS=6
# Standard prepayment percentage.
PREPAYMENT_PERCENT=50

# --- Runtime ---
LOG_LEVEL=info
STATE_FILE_PATH=./data/state.json
LOG_FILE_PATH=./logs/agent.log
# How often (minutes) to sweep Google Sheets for approaching/overdue deadlines.
DEADLINE_CHECK_INTERVAL_MINUTES=60

# --- LinguaManager CRM Integration ---
LINGUA_MANAGER_API_URL=https://linguamanager.duckdns.org/api
LINGUA_MANAGER_API_KEY=your_secret_key_here
BOT_MODE=crm
BOT_WEBHOOK_PORT=3001
BOT_WEBHOOK_SECRET=your_secret_key_here

